{
	"name": "ledger-site",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"data": "node scripts/extract-traces.mjs",
		"wasm": "node scripts/build-wasm.mjs",
		"dev": "npm run wasm && vite",
		"build": "npm run wasm && tsc --noEmit && vite build && vite build --ssr src/render.tsx --outDir .ssr --emptyOutDir && node scripts/prerender.mjs",
		"preview": "vite preview",
		"typecheck": "tsc --noEmit",
		"deploy:vercel": "npm run build && node scripts/vercel-output.mjs && vercel deploy --prebuilt --prod"
	},
	"dependencies": {
		"react": "^19.1.0",
		"react-dom": "^19.1.0"
	},
	"devDependencies": {
		"@types/node": "^22.20.5",
		"@types/react": "^19.1.0",
		"@types/react-dom": "^19.1.0",
		"@vitejs/plugin-react": "^5.0.0",
		"sharp": "^0.34.5",
		"typescript": "^5.9.3",
		"vite": "^7.1.0"
	},
	"engines": {
		"node": ">=22.0.0"
	}
}
