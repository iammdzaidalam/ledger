{
	"name": "grounded-ledger",
	"version": "0.2.0",
	"description": "A terminal coding agent that checks the model's claims against real tool output",
	"type": "module",
	"license": "MIT",
	"author": "iammdzaidalam",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/iammdzaidalam/ledger.git"
	},
	"keywords": [
		"ai",
		"agent",
		"cli",
		"llm",
		"coding-agent",
		"hallucination",
		"verification"
	],
	"bin": {
		"ledger": "./dist/index.js"
	},
	"files": [
		"dist",
		"bin/grounding-checker-*",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"dev": "tsx src/index.ts",
		"build": "npm run clean && tsc -p tsconfig.build.json && node scripts/build-checker.mjs",
		"check": "biome check .",
		"format": "biome format --write .",
		"lint": "biome lint .",
		"test": "vitest run",
		"test:watch": "vitest",
		"checker:build": "node scripts/build-checker.mjs",
		"checker:test": "go -C checker test ./...",
		"typecheck": "tsc -p tsconfig.eval.json",
		"checker:build:all": "node scripts/build-checker.mjs --all",
		"prepublishOnly": "npm run typecheck && npm run clean && tsc -p tsconfig.build.json && npm run checker:build:all",
		"eval:run": "tsx eval/run.ts",
		"eval:label": "tsx eval/label.ts",
		"eval:judge": "tsx eval/judge.ts",
		"eval:score": "tsx eval/score.ts",
		"eval:sample": "tsx eval/sample.ts",
		"eval:score-sampled": "tsx eval/score-sampled.ts",
		"eval:import-openhands": "tsx eval/import-openhands.ts",
		"clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
	},
	"dependencies": {
		"@anthropic-ai/sdk": "^0.32.0",
		"@google/genai": "^1.52.0",
		"consola": "^3.4.2",
		"diff": "^8.0.4",
		"glob": "^11.0.0",
		"groq-sdk": "^0.14.0",
		"ignore": "^7.0.5",
		"ink": "^8.0.0",
		"react": "^19.3.1"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.3.5",
		"@types/diff": "^7.0.1",
		"@types/node": "^22.15.29",
		"@types/react": "^19.3.0",
		"ink-testing-library": "^4.0.0",
		"tsx": "^4.22.1",
		"typescript": "^5.9.3",
		"vitest": "^4.1.8"
	},
	"engines": {
		"node": ">=22.0.0"
	}
}
